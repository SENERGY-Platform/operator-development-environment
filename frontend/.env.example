# Copy to .env.local and adjust. Vite only exposes VITE_-prefixed variables.

# Keycloak base URL. The /auth suffix is required against this deployment:
# it serves the legacy base path, while keycloak-js defaults to the one
# without it. Omitting it gives a 404 on the authorization endpoint.
VITE_KEYCLOAK_URL=https://auth.senergy.infai.org/auth
VITE_KEYCLOAK_REALM=master

# The client must be a public client with PKCE (S256) enabled, and must list
# this dev origin under Valid Redirect URIs — http://localhost:5173/* — or
# Keycloak answers "Invalid parameter: redirect_uri".
VITE_KEYCLOAK_CLIENT_ID=ode

# Where the backend is. Defaults to /api, which the Vite dev server proxies
# to http://localhost:8080 (see vite.config.ts).
VITE_API_BASE=/api
