# Copy to .env.local and adjust. Vite only exposes VITE_-prefixed variables.

# Keycloak base URL. Required — there is no default, because a deployment
# address does not belong in a committed file.
#
# The /auth suffix may be required: a Keycloak serving the legacy base path
# reports an issuer ending in /auth/realms/<realm>, while keycloak-js defaults
# to the path without it. Omitting it then gives a 404 on the authorization
# endpoint. Check the discovery document rather than guessing.
VITE_KEYCLOAK_URL=https://<keycloak-host>/auth
VITE_KEYCLOAK_REALM=master

# The client must be a public client with PKCE (S256) enabled, and must list
# this dev origin under Valid Redirect URIs — http://localhost:5173/* — or
# Keycloak answers "Invalid parameter: redirect_uri".
VITE_KEYCLOAK_CLIENT_ID=ode

# Where the backend is. Defaults to /api, which the Vite dev server proxies
# to http://localhost:8080 (see vite.config.ts).
VITE_API_BASE=/api
