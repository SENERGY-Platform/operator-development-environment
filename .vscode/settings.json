{
  "go.testFlags": ["-race"],
  "go.lintOnSave": "package",
  "[go]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "golang.go"
  },
  "files.exclude": {
    "**/node_modules": true,
    "frontend/dist": true,
    "frontend/*.tsbuildinfo": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "frontend/dist": true,
    "go.sum": true,
    "frontend/package-lock.json": true
  },
  "typescript.tsdk": "frontend/node_modules/typescript/lib"
}
