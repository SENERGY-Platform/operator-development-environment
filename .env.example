# Copy to .env and adjust. The "Backend" launch configuration reads it, and it
# overrides config.json using the usual camel-case-to-UPPER_SNAKE mapping.

# The Hub, and ODE's credential for it. See deploy/jupyterhub/README.md.
# A developer's own token from <hub>/hub/token holds the four required scopes
# restricted to that user, which is enough for everything in "Trying M4".
JUPYTERHUB_URL=http://proxy-public.jupyterhub.svc.cluster.local
JUPYTERHUB_TOKEN=
