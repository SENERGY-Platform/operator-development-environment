# Copy to .env and adjust. The "Backend" launch configuration reads it, and it
# overrides config.json using the usual camel-case-to-UPPER_SNAKE mapping.
#
# Every host below is a placeholder in angle brackets. That is deliberate: a
# reachable endpoint is deployment data and does not belong in a committed file,
# so the shape is documented here and the real value goes in your untracked .env.
#
# An empty value here is not a placeholder to be guessed at. ODE degrades
# deliberately without each of these and says at startup which surface is not
# served, so a deployment can be brought up one dependency at a time.

# The Hub, and ODE's credential for it. ODE needs a Hub *service* token holding
# servers, tokens, access:servers and users:activity, and refuses to start
# without all four. Granting them is cluster configuration, not ODE's.
# A developer's own token from <hub>/hub/token holds the four required scopes
# restricted to that user, which is enough for everything in "Trying M4".
JUPYTERHUB_URL=http://proxy-public.<hub-namespace>.svc.cluster.local
JUPYTERHUB_TOKEN=

# Ray and MLflow for M8 and M9 (SPEC §5.12), as they are addressed in this
# cluster. RAY_URL is the dashboard port, which is where the Job Submission API
# lives; `ray/dashboard` is a second service selecting the same head pod.
#
# RAY_DASHBOARD_URL and MLFLOW_UI_URL are what a *browser* opens and what the
# embed probe asks. They fall back to the two above, which is right whenever the
# browser resolves the same names the backend does — set them only when it does
# not. The two tokens are service accounts and stay empty for an unauthenticated
# in-cluster deployment.
RAY_URL=http://<ray-head-service>.<ray-namespace>.svc.cluster.local:8265
MLFLOW_URL=http://<mlflow-service>.<mlflow-namespace>.svc.cluster.local:5000
RAY_DASHBOARD_URL=
MLFLOW_UI_URL=
RAY_TOKEN=
MLFLOW_TOKEN=

# The GitHub OAuth app for the Code pane (SPEC §5.11). Create one under Settings →
# Developer settings → OAuth Apps, with the callback below as its Authorization
# callback URL — it has to match exactly, and it points at the SPA rather than at
# the backend, because the SPA holds the platform token that authorises the
# exchange. The key encrypts the developer's GitHub token at rest and is base64
# of 32 bytes: openssl rand -base64 32
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN_KEY=
GITHUB_REDIRECT_URI=http://localhost:5173/github/callback

# Postgres. Without it chat history, the tier audit trail, the override overlay,
# LLM spend accounting and the experiment records are in memory — a restart hands
# every developer a fresh spend allowance and loses the link from an MLflow run
# back to the commit it ran (SPEC §5.11 item 7). The schema is created at startup.
#
#   docker run -d --name ode-pg -p 5432:5432 \
#     -e POSTGRES_PASSWORD=ode -e POSTGRES_USER=ode -e POSTGRES_DB=ode postgres:17
POSTGRES_URL=

# The launch configuration enables the local `claude` CLI provider, which needs no
# key and reaches ODE's tools over MCP at public_url. Fill this only to use the
# Anthropic API directly instead.
ANTHROPIC_API_KEY=

# The scoped job credential of §3.1 item 6. Without these a Ray job carries the
# developer's interactive session token and a long run loses its platform access
# partway through — ODE warns at startup and says so in every launch result.
# KEYCLOAK_URL includes the /auth prefix this deployment serves, as the SPA's does.
# The audience is not optional in practice: Keycloak mints a token for the
# requesting client unless one names another, and a job reads timescale-wrapper.
KEYCLOAK_URL=
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
JOB_TOKEN_AUDIENCE=

# The four platform services behind imports as operator inputs (SPEC §5.2.1).
# All four have working values in config.json, so these are overrides rather than
# blanks to fill — set one only to point at a different deployment, or empty it to
# switch that half off deliberately.
#
# DEVICE_SELECTION_URL is the switch for the whole feature: empty means semantic
# selection reports devices only and says so in its notes, which is the honest
# degradation but does hide a whole class of operator input. It is used for
# imports and not for devices on purpose — its device answer drops the connection
# state, the device type name and the full device type, so ODE would have to read
# the devices again anyway.
#
# Setting it requires IMPORT_DEPLOY_URL: a selectables answer carries no container
# status, so without import-deploy a stopped import is indistinguishable from a
# running one and ODE refuses to start rather than rank one as the other.
#
# IMPORT_REPO_URL is needed only for get_import_type_metadata by type id;
# discovery returns the type alongside every instance. ANALYTICS_SERVING_URL is
# how a live-only import is told from an exported one — timescale-wrapper has no
# importId and no table worker materialises import tables, so an import's history
# exists only where an export was created for it. Without it that question answers
# "unknown", which is honest and is not the same claim as "no history".
DEVICE_SELECTION_URL=https://<platform-gateway>/device-selection
IMPORT_DEPLOY_URL=https://<platform-gateway>/import/deploy
IMPORT_REPO_URL=https://<platform-gateway>/import/repo
ANALYTICS_SERVING_URL=https://<platform-gateway>/analytics/serving
IMPORT_REQUEST_TIMEOUT=30s

# MOSES, the platform's environment simulator, is what ODE creates test scenarios
# with: a simulated site publishes through ordinary platform devices, so the
# ontology tools and the profiler find what it sends like anything else. Empty
# leaves the simulation tools declared and unavailable, which is a working
# deployment — nothing in ODE requires a simulator.
#
# There is no token beside this and there will not be one. MOSES takes an
# environment's owner from the caller's token, so a service account would create
# simulations belonging to ODE that nobody could find and nobody could delete.
MOSES_URL=https://<platform-gateway>/moses
MOSES_REQUEST_TIMEOUT=60s
MOSES_MAX_DATASET_BYTES=10485760
