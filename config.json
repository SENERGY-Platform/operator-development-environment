{
  "api_port": "8080",
  "debug": true,

  "required_realm_role": "developer",

  "device_repo_url": "https://api.senergy.infai.org/device-repository",
  "timescale_wrapper_url": "https://api.senergy.infai.org/db/v3",

  "ontology_cache_ttl": "1h",
